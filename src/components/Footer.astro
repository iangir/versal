	<div class='container'>
		<div class={styles.bottom}>
			<p>&copy; {year} Версаль, банкетный зал. Все права защищены.</p>
			<div class={styles.navBtns}>
				<a class={styles.topLink} href='#booking'>Записаться на просмотр</a>
				<a class={styles.topLink} href='#top'>
					Наверх <span aria-hidden='true'>&uarr;</span>
				</a>
			</div>
		</div>
	</div>
</footer>
